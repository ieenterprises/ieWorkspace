# Full ieWorkspace image built by GitHub Actions (.github/workflows/build-ieworkspace.yml)
# and published to ghcr.io/ieenterprises/ieworkspace:main
FROM ghcr.io/leag1234/elixiroffice-server:beta1.1

# 1. Start page / PWA brand assets (round logo, favicon, manifest, icons, badged editor favicons)
RUN mkdir -p /var/www/elixiroffice/ieworkspace-brand/favicons
COPY branding/example/nodejs/public/elixir/brand/logo.svg \
     branding/example/nodejs/public/elixir/brand/favicon.svg \
     branding/example/nodejs/public/elixir/brand/manifest.webmanifest \
     branding/example/nodejs/public/elixir/brand/icon-192.png \
     branding/example/nodejs/public/elixir/brand/icon-512.png \
     branding/example/nodejs/public/elixir/brand/icon-maskable-512.png \
     branding/example/nodejs/public/elixir/brand/download-menu.js \
     branding/example/nodejs/public/elixir/brand/ai-assistant.js \
     /var/www/elixiroffice/ieworkspace-brand/
COPY branding/example/nodejs/public/elixir/brand/favicons/word.ico \
     branding/example/nodejs/public/elixir/brand/favicons/cell.ico \
     branding/example/nodejs/public/elixir/brand/favicons/slide.ico \
     branding/example/nodejs/public/elixir/brand/favicons/pdf.ico \
     /var/www/elixiroffice/ieworkspace-brand/favicons/

# 2. Editor header, about, embed, and welcome logos (desktop + mobile)
COPY branding/web-apps/theme/elixiroffice/assets/img/header/logo_light.svg \
     branding/web-apps/theme/elixiroffice/assets/img/header/logo_dark.svg \
     branding/web-apps/theme/elixiroffice/assets/img/header/header-logo_s.svg \
     branding/web-apps/theme/elixiroffice/assets/img/header/dark-logo_s.svg \
     /var/www/elixiroffice/documentserver/web-apps/apps/common/main/resources/img/header/

COPY branding/web-apps/theme/elixiroffice/assets/img/header/logo_light.svg \
     branding/web-apps/theme/elixiroffice/assets/img/header/logo_dark.svg \
     branding/web-apps/theme/elixiroffice/assets/img/header/header-logo_s.svg \
     branding/web-apps/theme/elixiroffice/assets/img/header/dark-logo_s.svg \
     /var/www/elixiroffice/documentserver/web-apps/apps/common/mobile/resources/img/header/

COPY branding/web-apps/theme/elixiroffice/assets/img/about/logo.svg \
     /var/www/elixiroffice/documentserver/web-apps/apps/common/main/resources/img/about/logo.svg
COPY branding/web-apps/theme/elixiroffice/assets/img/about/logo.svg \
     /var/www/elixiroffice/documentserver/web-apps/apps/common/main/resources/img/about/logo_s.svg
COPY branding/web-apps/theme/elixiroffice/assets/img/header/logo_dark.svg \
     /var/www/elixiroffice/documentserver/web-apps/apps/common/main/resources/img/about/logo-white_s.svg
COPY branding/web-apps/theme/elixiroffice/assets/img/about/logo.svg \
     /var/www/elixiroffice/documentserver/web-apps/apps/common/mobile/resources/img/about/logo.svg

COPY branding/web-apps/theme/elixiroffice/assets/img/embed/logo.svg \
     /var/www/elixiroffice/documentserver/web-apps/apps/common/main/resources/img/embed/logo.svg
COPY branding/web-apps/theme/elixiroffice/assets/img/embed/logo.svg \
     /var/www/elixiroffice/documentserver/web-apps/apps/common/mobile/resources/img/embed/logo.svg
COPY branding/web-apps/theme/elixiroffice/assets/img/embed/logo.svg \
     /var/www/elixiroffice/documentserver/web-apps/apps/common/embed/resources/img/logo.svg

COPY branding/web-apps/theme/elixiroffice/assets/img/header/logo_light.svg \
     /var/www/elixiroffice/documentserver-example/welcome/css/logo.svg

# 3. Regenerate .gz files for nginx gzip_static and fix permissions
RUN set -e; \
    for f in \
      /var/www/elixiroffice/documentserver/web-apps/apps/common/main/resources/img/header/*.svg \
      /var/www/elixiroffice/documentserver/web-apps/apps/common/main/resources/img/about/*.svg \
      /var/www/elixiroffice/documentserver/web-apps/apps/common/main/resources/img/embed/*.svg \
      /var/www/elixiroffice/documentserver/web-apps/apps/common/mobile/resources/img/header/*.svg \
      /var/www/elixiroffice/documentserver/web-apps/apps/common/mobile/resources/img/about/*.svg \
      /var/www/elixiroffice/documentserver/web-apps/apps/common/mobile/resources/img/embed/*.svg \
      /var/www/elixiroffice/documentserver/web-apps/apps/common/embed/resources/img/*.svg; do \
      [ -f "$f" ] && gzip -kf "$f" && chmod 644 "$f" "$f.gz"; \
    done; \
    chmod -R a+rX /var/www/elixiroffice/ieworkspace-brand

# 4. Start page config (appName: ieWorkspace) and nginx branding overlay
ENV EXAMPLE_ENABLED=true \
    GENERATE_FONTS=false

COPY deploy/server/example.json /etc/elixiroffice/documentserver-example/local-production-linux.json
COPY deploy/render/ds-example.conf /etc/nginx/includes/ds-example.conf

# 5. Force example service to autostart on port 3000 (prevents PaaS PORT=80/10000 from breaking upstream localhost:3000),
#    and redirect root "/" directly to ieWorkspace Home (/example/) instead of /welcome/
RUN set -e; \
    chmod 644 /etc/elixiroffice/documentserver-example/local-production-linux.json; \
    if [ -f /etc/supervisor/conf.d/ds-example.conf ]; then \
      sed -i 's/^autostart=false$/autostart=true/' /etc/supervisor/conf.d/ds-example.conf; \
      sed -i 's/^environment=/environment=PORT=3000,/' /etc/supervisor/conf.d/ds-example.conf; \
    fi; \
    for f in /etc/elixiroffice/documentserver/nginx/includes/ds-docservice.conf /etc/nginx/includes/ds-docservice.conf; do \
      [ -f "$f" ] && sed -i 's|/welcome/|/example/|g' "$f"; \
    done; \
    for f in /var/www/elixiroffice/documentserver-example/welcome/docker.html /var/www/elixiroffice/documentserver-example/welcome/example-disabled.html; do \
      [ -f "$f" ] && sed -i 's/ElixirOffice/ieWorkspace/g' "$f"; \
    done
